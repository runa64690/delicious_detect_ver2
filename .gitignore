# Python virtual environments
.venv/
venv/
env/

# Python caches and tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# Local environment variables and secrets
.env
.env.*
!.env.example

# IDE, editor, OS, and local Codex files
.vscode/
.idea/
.agents/
.codex/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp

# Experimental data (may contain participant data)
data/
facemesh_csv/
video_data/
baseline_delta_csv/
normalized_facemesh_csv/
nose_origin_facemesh_csv/

# Generated analysis outputs (features, exclusions, plots, metrics)
results/

# Future machine-learning artifacts
checkpoints/
runs/
mlruns/

# Local participant exclusions (publish the empty example only)
/config/excluded_trials.csv

# Downloaded / trained model artifacts
*.task
*.joblib
*.pkl
*.pickle
*.onnx
*.tflite
*.pt
*.pth
*.h5
*.keras

# Recordings and tabular experiment exports outside their default folders
*.mp4
*.avi
*.mov
*.mkv
*.h264
*.csv
*.jsonl
*.npy
*.npz
!config/*.example.csv

# Machine-local settings and credentials
.aws/
.ssh/
*.pem
*.key
*.p12
*.pfx
*.local.json
*.local.yaml
*.local.yml

# Only explicitly selected documentation images belong in Git
*.jpg
*.jpeg
*.png
*.webp
!docs/images/*.jpg
!docs/images/*.jpeg
!docs/images/*.png
!docs/images/*.webp
