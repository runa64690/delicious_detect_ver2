{
  "input_path": "results/features.csv",
  "excluded_trials_path": "config/excluded_trials.csv",
  "output_root": "results/ml",
  "positive_label": 1,
  "group_column": "participant_id",
  "target_column": "drink_label",
  "random_seed": 42,
  "primary_metric": "balanced_accuracy",
  "models": {
    "dummy": {
      "strategy": "prior",
      "random_state": 42
    },
    "extra_trees": {
      "n_estimators": 1000,
      "max_features": "sqrt",
      "min_samples_leaf": 2,
      "class_weight": "balanced",
      "random_state": 42,
      "n_jobs": -1
    },
    "random_forest": {
      "n_estimators": 1000,
      "max_features": "sqrt",
      "min_samples_leaf": 2,
      "class_weight": "balanced",
      "random_state": 42,
      "n_jobs": -1
    }
  }
}
